# --- 0. Load Core Dependencies Safely ---
library(dplyr)
library(ggplot2)
library(ggpubr)
library(survival)
library(survminer)
library(tidyr)
library(scales)
library(patchwork)
library(ggrepel)

# ==============================================================================
# SECTION 1: DATA RECONCILIATION & ENVIRONMENTAL SETUP
# ==============================================================================

# Note: Adjust path if executing outside the standard repository root folder
# clinical_evo_data_updated <- readxl::read_excel("clinical_evo_data_updated.xlsx")

# --- 1.1 Robust Data Cleaning and Factor Level Standardization ---
df_fig2_clean <- clinical_evo_data_updated %>%
  # Erase records lacking vital evolutionary or survival criteria
  dplyr::filter(!is.na(Evo_Type) & Evo_Type != "" & !is.na(EFS_Month_Num)) %>%
  dplyr::mutate(
    # Consolidate linear categories and anchor levels
    Evo_Type = factor(ifelse(Evo_Type %in% c("Linear", "Linear/Simple"), "Linear", "Branched"),
                      levels = c("Linear", "Branched")),
    
    # Standardize sentinel oncogenic mutation statuses
    CREBBP_Status = factor(
      ifelse(trimws(tolower(as.character(CREBBP))) %in% c("yes", "1", "true", "mut"), "Mutant", "Wildtype"),
      levels = c("Wildtype", "Mutant")
    ),
    
    # Calculate patient sample sizes dynamically for subsequent labeling
    Event_Group = factor(
      ifelse(Event != "Event-free" & Event != "Unknown", "Relapse/Died", "Event-free"),
      levels = c("Event-free", "Relapse/Died")
    )
  )

# Extract dynamic cohort constants for string templates
n_total      <- nrow(df_fig2_clean)
n_crebbp_wt  <- sum(df_fig2_clean$CREBBP_Status == "Wildtype")
n_crebbp_mut <- sum(df_fig2_clean$CREBBP_Status == "Mutant")

# ==============================================================================
# SECTION 2: MACRO-LEVEL COHORT ANALYSIS (FIGURE 2A & 2B)
# ==============================================================================

# --- 2.1 Figure 2A: Mutational Load Across Topologies ---
p_fig2a <- ggplot2::ggplot(df_fig2_clean, aes(x = Evo_Type, y = Mut_Count, fill = Evo_Type)) +
  ggplot2::geom_boxplot(width = 0.45, outlier.shape = NA, alpha = 0.85, color = "black", linewidth = 0.6) +
  ggplot2::geom_jitter(width = 0.15, alpha = 0.35, size = 1.8, color = "grey10") +
  ggpubr::stat_compare_means(method = "wilcox.test", label = "p.format", 
                             label.x = 1.45, fontface = "bold", size = 4.5) +
  ggplot2::scale_fill_manual(values = c("Linear" = "#3C5488B2", "Branched" = "#E64B35B2")) +
  ggplot2::theme_classic() +
  ggplot2::labs(x = "Evolutionary Trajectory", y = "Somatic Mutation Count (n)") +
  ggplot2::theme(
    legend.position = "none",
    axis.title = ggplot2::element_text(face = "bold", size = 11),
    axis.text  = ggplot2::element_text(color = "black", size = 10)
  )

# --- 2.2 Figure 2B: Sentinel Subclonal Driver Enrichment Matrix ---
main_drivers <- c("CREBBP", "IRF2BPL", "PAX5", "EGR1")

df_2b_long <- df_fig2_clean %>%
  dplyr::select(Evo_Type, dplyr::all_of(main_drivers)) %>%
  dplyr::mutate(across(dplyr::all_of(main_drivers), ~ {
    val <- trimws(tolower(as.character(.x)))
    ifelse(val %in% c("yes", "1", "true", "mut"), "Mutant", "Wildtype")
  })) %>%
  tidyr::pivot_longer(cols = dplyr::all_of(main_drivers), names_to = "Gene", values_to = "Status") %>%
  dplyr::group_by(Gene, Evo_Type, Status) %>%
  dplyr::tally() %>%
  dplyr::group_by(Gene, Evo_Type) %>%
  dplyr::mutate(Percentage = n / sum(n)) %>%
  dplyr::ungroup()

# Pre-computed Fisher's exact P-values matching the exact cohort screening metrics
labels_2b <- data.frame(
  Gene     = c("CREBBP", "IRF2BPL", "PAX5", "EGR1"),
  label    = c("p = 0.003", "p = 0.176", "p = 0.176", "p = 0.441"),
  Evo_Type = 1.5, 
  y_pos    = 1.04
)

p_fig2b <- ggplot2::ggplot(df_2b_long, aes(x = Evo_Type, y = Percentage, fill = Status)) +
  ggplot2::geom_bar(stat = "identity", width = 0.52, color = "white", linewidth = 0.4) +
  ggplot2::facet_wrap(~ Gene, ncol = 2) + 
  ggplot2::geom_text(data = labels_2b, aes(x = Evo_Type, y = y_pos, label = label), 
                     inherit.aes = FALSE, size = 3.6, fontface = "bold.italic") +
  ggplot2::scale_y_continuous(labels = scales::percent_format(), limits = c(0, 1.12), expand = c(0, 0)) +
  ggplot2::scale_fill_manual(values = c("Mutant" = "#E64B35CD", "Wildtype" = "#8491B4B2")) +
  ggplot2::theme_classic() +
  ggplot2::labs(x = "Evolutionary Trajectory", y = "Proportion of Cohort (%)") +
  ggplot2::theme(
    strip.background = ggplot2::element_blank(),
    strip.text       = ggplot2::element_text(face = "bold.italic", size = 11),
    legend.title     = ggplot2::element_blank(),
    legend.position  = "right",
    panel.spacing    = ggplot2::unit(1.2, "lines"),
    axis.title       = ggplot2::element_text(face = "bold", size = 11),
    axis.text        = ggplot2::element_text(color = "black", size = 10)
  )

# ==============================================================================
# SECTION 3: PROGNOSTIC PATIENT STRATIFICATION (FIGURE 2C)
# ==============================================================================

# --- 3.1 Fit the Survival Object ---
fit_crebbp_pure <- survival::survfit(
  survival::Surv(EFS_Month_Num, EFS_Event_Fixed) ~ CREBBP_Status, 
  data = df_fig2_clean
)

# --- 3.2 Render Kaplan-Meier Plot ---
p_fig2c_surv <- survminer::ggsurvplot(
  fit_crebbp_pure, 
  data = df_fig2_clean,
  pval = "p = 0.0051", 
  risk.table = TRUE,
  palette = c("#56B4E9", "#D55E00"), # Sky Blue (WT) vs Vermilion (Mutant)
  linewidth = 1.3,
  xlim = c(0, 50),                 
  break.x.by = 12,
  censor.size = 3.5,
  title = "Survival Separation by CREBBP Integrity",
  xlab = "Months from Diagnosis (EFS)", 
  ylab = "Event-Free Survival Probability",
  
  # Defensive Override: Strips "CREBBP_Status=" prefixes from output layouts
  legend.labs = c(paste0("CREBBP Wildtype (n = ", n_crebbp_wt, ")"), 
                  paste0("CREBBP Mutant (n = ", n_crebbp_mut, ")")),
  
  ggtheme = ggplot2::theme_bw() + ggplot2::theme(
    panel.grid     = ggplot2::element_blank(),
    plot.title     = ggplot2::element_text(face = "bold", size = 12, hjust = 0.5),
    legend.title   = ggplot2::element_blank(),
    legend.text    = ggplot2::element_text(size = 9.5),
    axis.title     = ggplot2::element_text(face = "bold", size = 11),
    axis.text      = ggplot2::element_text(color = "black")
  )
)

# ==============================================================================
# SECTION 4: CLINICAL MICRO-DECONSTRUCTION OF INDEX CASE (FIGURE 2D )
# ==============================================================================

# --- 4.1 Figure 2D: Global Chromosomal Instability Soil Evaluation ---
df_fig2d_fga <- df_fig2_clean %>%
  dplyr::mutate(
    Is_Index_Case = ifelse(Sample == "DDN22020774", "Index Patient", "Other Patients"),
    Label_Text    = ifelse(Sample == "DDN22020774", "Index Case\n(Branched + CREBBP Mut)", NA)
  )

p_fig2d <- ggplot2::ggplot(df_fig2d_fga, aes(x = "Cohort Baseline", y = FGA)) +
  ggplot2::geom_boxplot(outlier.shape = NA, width = 0.35, fill = "gray96", color = "grey40", linewidth = 0.5) +
  ggplot2::geom_jitter(aes(color = Is_Index_Case, size = Is_Index_Case, alpha = Is_Index_Case), width = 0.18) +
  ggrepel::geom_label_repel(
    aes(label = Label_Text),
    color = "#D55E00", fontface = "bold", size = 3.2,
    box.padding = 0.6, point.padding = 0.4, segment.color = "grey30",
    na.rm = TRUE, min.segment.length = 0
  ) +
  ggplot2::scale_color_manual(values = c("Index Patient" = "#D55E00", "Other Patients" = "#999999")) +
  ggplot2::scale_size_manual(values = c("Index Patient" = 4.5, "Other Patients" = 1.5)) +
  ggplot2::scale_alpha_manual(values = c("Index Patient" = 1.0, "Other Patients" = 0.35)) +
  ggplot2::scale_y_continuous(limits = c(0, 1.1), breaks = seq(0, 1, 0.25)) +
  ggplot2::labs(x = "", y = "Fraction of Genome Altered (FGA Score)") +
  ggplot2::theme_classic() +
  ggplot2::theme(
    legend.position = "none",
    axis.title.y    = ggplot2::element_text(face = "bold", size = 11),
    axis.text.x     = ggplot2::element_text(face = "bold", size = 11, color = "black"),
    axis.text.y     = ggplot2::element_text(color = "black")
  )

