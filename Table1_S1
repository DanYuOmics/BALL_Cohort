# --- A. load the data
table1_prepared <- clinical_data %>%
  mutate(
    Table_1_Group = case_when(
      Subtype == "ETV6-RUNX1" ~ "ETV6-RUNX1",
      Subtype %in% c("BCR-ABL1", "IKZF1-deleted", "ABL1-rearranged", "CRLF2-rearranged") ~ "BCR-ABL1 / Ph-like",
      Subtype == "TCF3-PBX1" ~ "TCF3-PBX1",
      grepl("KMT2A|MEF2D|ZNF384|DUX4|PAX5|NUTM1|IGH|TCRA|IGK", Subtype) ~ "KMT2A / DUX4 / Other Fusions",
      Subtype == "B-other" ~ "B-other (Unclassified)",
      Subtype == "Not Determined" ~ "Not Determined (Missing Data)",
      TRUE ~ "Rare Rearrangements"
    ),
    Table_1_Group = factor(Table_1_Group, levels = c(
      "ETV6-RUNX1", 
      "BCR-ABL1 / Ph-like", 
      "TCF3-PBX1", 
      "KMT2A / DUX4 / Other Fusions", 
      "Rare Rearrangements", 
      "B-other (Unclassified)", 
      "Not Determined (Missing Data)"
    ))
  ) %>%
  set_variable_labels(Table_1_Group = "Molecular Subtype")

# --- B. Table 1 
table1_obj <- table1_prepared %>%
  select(Age_Months, Sex, Ethnicity_Group, WBC, Immunophenotype, CNS_Status, 
         NCI_Risk_Group, Table_1_Group, Regimen_Clean, Blina_Used, HSCT, 
         BM_Status_D46, MRD_Flow, Relapse_Status, Vital_Status, EFS_Month, OS_Month) %>%
  tbl_summary(
    
    statistic = list(
      all_continuous() ~ "{median} ({p25} - {p75})",
      all_categorical() ~ "{n} ({p}%)"
    ),
    digits = all_continuous() ~ fmt_1d,
    missing = "no"
  ) %>%
  modify_header(all_stat_cols() ~ "**Total** (N={n})¹") %>%
  modify_footnote(
    all_stat_cols() ~ "1 Statistics: median (IQR) or n (%). \n2 MRD was assessed via flow cytometry."
  ) %>%
  bold_labels()

# --- C. Table S1 
table_s2_obj <- table1_prepared %>%
  select(Age_Months, Sex, Ethnicity_Group, WBC, Immunophenotype, CNS_Status, 
         NCI_Risk_Group, Table_1_Group, Regimen_Clean, Blina_Used, HSCT, 
         BM_Status_D46, MRD_Flow, Relapse_Status, Vital_Status, EFS_Month, OS_Month) %>%
  tbl_summary(
    by = Table_1_Group, 
    missing = "no",
    digits = all_continuous() ~ fmt_1d
  ) %>%
  add_p(
    test = list(all_categorical() ~ "fisher.test"),
    test.args = list(all_categorical() ~ list(simulate.p.value = TRUE, B = 2000))
  ) %>%
  modify_header(all_stat_cols() ~ "**{level}** (N={n})") %>%
  bold_labels()

# ==============================================================================
# 5. output
# ==============================================================================
apply_style <- function(gt_obj) {
  gt_obj %>% as_flex_table() %>% 
    font(fontname = "Arial", part = "all") %>% 
    fontsize(size = 8, part = "all") %>% 
    autofit()
}

save_as_docx(
  "Table 1" = apply_style(table1_obj), 
  "Table S2" = apply_style(table_s2_obj), 
  path = "article/Table_1_Final.docx"
)
